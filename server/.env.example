# Copy this file to .env and adjust values for your machine.
# Never commit the real .env file.

DATABASE_URL="file:./dev.db"
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
PUBLIC_APP_URL="http://localhost:5173"

# Set to 1 only when a trusted reverse proxy sits in front of Express.
# Never enable this when the API is directly exposed to the internet.
TRUST_PROXY=false

# Optional: override the uploaded-image directory (default: server/uploads).
# UPLOADS_DIR=

# Vendor account created/updated by `npm run db:seed`.
# Set a strong password before running the seed. Never commit real credentials.
VENDOR_NAME="Burger House Owner"
VENDOR_EMAIL="owner@burgerhouse.local"
VENDOR_USERNAME="owner"
VENDOR_PASSWORD=""
